<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>FreshCart - Online Grocery Store</title>
<script src="https://unpkg.com/react@18.3.1/umd/react.development.js"></script>
<script src="https://unpkg.com/react-dom@18.3.1/umd/react-dom.development.js"></script>
<script src="https://unpkg.com/@babel/standalone@7.24.7/babel.min.js"></script>
<style>
* {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
  font-family: "Trebuchet MS", sans-serif;
  scroll-behavior: smooth;
}
.app {
  min-height: 100vh;
  background: var(--bg);
  color: var(--text);
  transition: 0.3s;
}
.light {
  --bg: #f4faf0;
  --card: #ffffff;
  --text: #2b3a2b;
  --muted: #6f7f6f;
}
.dark {
  --bg: #1b2a20;
  --card: #26382c;
  --text: #ffffff;
  --muted: #b9c9bd;
}
header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 18px 7%;
  background: var(--card);
  box-shadow: 0 3px 12px #0001;
  position: sticky;
  top: 0;
  z-index: 10;
}
header h2, footer h3 {
  color: #43a047;
}
nav {
  display: flex;
  gap: 22px;
}
nav a {
  text-decoration: none;
  color: var(--text);
  font-weight: bold;
}
button {
  cursor: pointer;
  border: none;
  border-radius: 20px;
  padding: 10px 16px;
  background: #ef6c00;
  color: white;
  font-weight: bold;
}
button:hover {
  opacity: 0.85;
}
main {
  max-width: 1150px;
  margin: auto;
  padding: 25px;
}

/* Welcome Section */
.hero {
  background: linear-gradient(120deg, #c8e6c9, #fff3c4);
  color: #2b3a2b;
  border-radius: 22px;
  padding: 50px 35px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20px;
}
.hero h1 {
  font-size: 35px;
  margin-bottom: 15px;
}
.hero h2 {
  margin-bottom: 12px;
}
.hero p {
  line-height: 1.7;
  max-width: 520px;
}
.hero-image {
  font-size: 65px;
}
.start-btn {
  display: inline-block;
  margin-top: 20px;
  background: #ef6c00;
  color: white;
  padding: 12px 22px;
  border-radius: 25px;
  text-decoration: none;
}

/* Statistics */
.stats {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 20px;
  margin: 30px 0;
}
.stat-card {
  background: var(--card);
  text-align: center;
  padding: 22px;
  border-radius: 16px;
  box-shadow: 0 3px 12px #0001;
}
.stat-card span {
  font-size: 30px;
}
.stat-card h3 {
  color: #43a047;
  font-size: 27px;
  margin: 8px;
}

/* Categories */
.section-title {
  margin: 35px 0 20px;
  font-size: 25px;
}
.category-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 18px;
}
.category-card {
  background: var(--card);
  padding: 23px 17px;
  border-radius: 15px;
  text-align: center;
  box-shadow: 0 3px 12px #0001;
  transition: 0.3s;
}
.category-card:hover {
  transform: translateY(-7px);
}
.category-icon {
  font-size: 42px;
}
.category-card h3 {
  margin: 12px 0;
}
.category-card p {
  color: var(--muted);
  font-size: 14px;
  line-height: 1.6;
  min-height: 45px;
}
.price {
  color: #c62828;
  font-weight: bold;
  margin-top: 8px;
}
.category-card button {
  margin-top: 12px;
}

/* Shopping List */
.shopping {
  background: var(--card);
  padding: 25px;
  border-radius: 18px;
  margin-top: 35px;
}
.item-form {
  display: flex;
  gap: 10px;
  margin-bottom: 20px;
}
.item-form input {
  flex: 1;
  min-width: 0;
  padding: 13px;
  border: 1px solid #ddd;
  border-radius: 10px;
  background: var(--bg);
  color: var(--text);
}
.item {
  display: flex;
  justify-content: space-between;
  padding: 14px 5px;
  border-bottom: 1px solid #8883;
}
.item label {
  display: flex;
  gap: 12px;
  align-items: center;
}
.item input {
  accent-color: #43a047;
  width: 17px;
  height: 17px;
}
.done {
  text-decoration: line-through;
  color: var(--muted);
}
.delete {
  background: none;
  color: #ed6262;
  font-size: 18px;
}

/* Progress */
.progress {
  margin-top: 25px;
}
.progress-bar {
  height: 13px;
  background: #ddd;
  border-radius: 20px;
  overflow: hidden;
  margin: 12px 0;
}
.progress-fill {
  height: 100%;
  background: linear-gradient(90deg, #43a047, #ef6c00);
  transition: width 0.4s;
}
footer {
  text-align: center;
  padding: 30px;
  margin-top: 35px;
  background: var(--card);
  line-height: 2;
}

/* Responsive Design */
@media (max-width: 750px) {
  header {
    flex-wrap: wrap;
    gap: 15px;
  }
  .hero {
    flex-direction: column;
    text-align: center;
  }
  .category-grid {
    grid-template-columns: repeat(2, 1fr);
  }
}
@media (max-width: 480px) {
  main {
    padding: 15px;
  }
  .stats, .category-grid {
    grid-template-columns: 1fr;
  }
  .item-form {
    flex-direction: column;
  }
  nav {
    gap: 12px;
  }
  .hero h1 {
    font-size: 27px;
  }
}
</style>
</head>
<body>

<div id="root"></div>

<script type="text/babel">
const { useState } = React;

// Header Component (props: theme, toggleTheme)
function Header({ theme, toggleTheme }) {
  return (
    <header>
      <h2>&#128722; FreshCart</h2>
      <nav>
        <a href="#home">Home</a>
        <a href="#categories">Categories</a>
        <a href="#shopping">Shopping List</a>
      </nav>
      <button onClick={toggleTheme}>
        {theme === "light" ? "\u{1F319} Dark" : "\u2600\uFE0F Light"}
      </button>
    </header>
  );
}

// Category Card Component (props: icon, title, description, price, color, onAdd)
function CategoryCard({ icon, title, description, price, color, onAdd }) {
  return (
    <div className="category-card"
         style={{ borderTop: `5px solid ${color}` }}>
      <span className="category-icon">{icon}</span>
      <h3>{title}</h3>
      <p>{description}</p>
      <p className="price">Rs. {price}</p>
      <button onClick={() => onAdd(title)}>
        + Add to List
      </button>
    </div>
  );
}

// Shopping List Component (props: items, toggleItem, deleteItem)
function ShoppingList({ items, toggleItem, deleteItem }) {
  return (
    <div>
      {items.length === 0 ? (
        <p>Your list is empty. Add a new item!</p>
      ) : (
        items.map(item => (
          <div className="item" key={item.id}>
            <label>
              <input
                type="checkbox"
                checked={item.purchased}
                onChange={() => toggleItem(item.id)}
              />
              <span className={item.purchased ? "done" : ""}>
                {item.name}
              </span>
            </label>
            <button className="delete"
                    onClick={() => deleteItem(item.id)}>
              &#10005;
            </button>
          </div>
        ))
      )}
    </div>
  );
}

// Main Application Component
function App() {
  const [theme, setTheme] = useState("light");
  const [input, setInput] = useState("");
  const [items, setItems] = useState([
    { id: 1, name: "Tomato - 1 kg", purchased: true },
    { id: 2, name: "Milk - 2 litres", purchased: false },
    { id: 3, name: "Basmati Rice - 5 kg", purchased: false },
    { id: 4, name: "Apple - 1 kg", purchased: false }
  ]);

  const toggleTheme = () => {
    setTheme(theme === "light" ? "dark" : "light");
  };

  const addItemByName = (name) => {
    setItems([
      ...items,
      { id: Date.now(), name: name, purchased: false }
    ]);
  };

  const addItem = (e) => {
    e.preventDefault();
    if (!input.trim()) return;
    addItemByName(input.trim());
    setInput("");
  };

  const toggleItem = (id) => {
    setItems(items.map(item =>
      item.id === id
        ? { ...item, purchased: !item.purchased }
        : item
    ));
  };

  const deleteItem = (id) => {
    setItems(items.filter(item => item.id !== id));
  };

  const purchased = items.filter(item => item.purchased).length;

  return (
    <div className={`app ${theme}`} id="home">
      <Header theme={theme} toggleTheme={toggleTheme} />

      <main>
        <section className="hero">
          <div>
            <h1>Welcome to FreshCart! &#127881;</h1>
            <h2>Fresh Groceries, Delivered Happily!</h2>
            <p>
              Shop vegetables, fruits, dairy and daily essentials at the
              best prices. Plan your shopping list and track your purchases.
            </p>
            <a href="#categories" className="start-btn">
              Start Shopping &#128717;
            </a>
          </div>
          <div className="hero-image">&#129388; &#127823; &#129371;</div>
        </section>

        <section className="stats">
          <div className="stat-card">
            <span>&#128230;</span>
            <h3>4</h3>
            <p>Categories</p>
          </div>
          <div className="stat-card">
            <span>&#9989;</span>
            <h3>{purchased}</h3>
            <p>Items Purchased</p>
          </div>
          <div className="stat-card">
            <span>&#128203;</span>
            <h3>{items.length}</h3>
            <p>Total Items</p>
          </div>
        </section>

        <section id="categories">
          <h2 className="section-title">&#128717; Shop by Category</h2>
          <div className="category-grid">
            <CategoryCard icon="&#129388;" title="Vegetables"
              description="Fresh farm vegetables every day."
              price="40 / kg" color="#43a047" onAdd={addItemByName} />
            <CategoryCard icon="&#127822;" title="Fruits"
              description="Sweet and juicy seasonal fruits."
              price="180 / kg" color="#e53935" onAdd={addItemByName} />
            <CategoryCard icon="&#129371;" title="Dairy"
              description="Milk, curd, butter and cheese."
              price="56 / litre" color="#1e88e5" onAdd={addItemByName} />
            <CategoryCard icon="&#127866;" title="Beverages"
              description="Juices, tea, coffee and soft drinks."
              price="90 / litre" color="#ef6c00" onAdd={addItemByName} />
          </div>
        </section>

        <section id="shopping" className="shopping">
          <h2 className="section-title">&#128221; My Shopping List</h2>

          <form className="item-form" onSubmit={addItem}>
            <input
              type="text"
              placeholder="Enter a new grocery item..."
              value={input}
              onChange={e => setInput(e.target.value)}
            />
            <button type="submit">+ Add Item</button>
          </form>

          <ShoppingList
            items={items}
            toggleItem={toggleItem}
            deleteItem={deleteItem}
          />

          <div className="progress">
            <h3>&#128200; Your Shopping Progress</h3>
            <div className="progress-bar">
              <div className="progress-fill"
                   style={{
                     width: `${items.length
                       ? purchased / items.length * 100 : 0}%`
                   }}>
              </div>
            </div>
            <p>{purchased} out of {items.length} items purchased!</p>
          </div>
        </section>

        <footer>
          <h3>&#128722; FreshCart</h3>
          <p>Fresh groceries at your doorstep!</p>
          <p>&copy; 2026 FreshCart. All Rights Reserved.</p>
        </footer>
      </main>
    </div>
  );
}

ReactDOM.createRoot(document.getElementById("root")).render(<App />);
</script>

</body>
</html>
