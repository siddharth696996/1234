<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>FreshCart Online Grocery Store</title>
  <style>
    * { box-sizing: border-box; margin: 0; padding: 0; }
    body { font-family: Arial, sans-serif; background: #f4f9f1; color: #333; }

    /* Header */
    header { background: #2e7d32; color: #fff; text-align: center; padding: 20px; }
    header p { margin-top: 5px; }

    /* Navigation */
    nav { background: #1b5e20; display: flex; justify-content: center; flex-wrap: wrap; }
    nav a { color: #fff; text-decoration: none; padding: 14px 22px; }
    nav a:hover { background: #43a047; }

    /* Hero */
    .hero { text-align: center; padding: 70px 20px; color: #fff;
            background: linear-gradient(rgba(0,0,0,0.45), rgba(0,0,0,0.45)),
            url("https://images.unsplash.com/photo-1542838132-92c53300491e?w=1200") center/cover #66bb6a; }
    .hero h2 { font-size: 32px; margin-bottom: 10px; }
    .hero p { margin-bottom: 20px; }

    /* Buttons */
    button, .btn { background: #ef6c00; color: #fff; border: none; padding: 10px 20px;
                   border-radius: 5px; cursor: pointer; font-size: 15px; text-decoration: none; }
    button:hover, .btn:hover { background: #e65100; }

    /* Main layout: sidebar + content */
    .container { display: flex; gap: 20px; max-width: 1100px; margin: 20px auto; padding: 0 15px; }
    aside { flex: 1; background: #fff; padding: 20px; border-radius: 8px;
            box-shadow: 0 2px 6px rgba(0,0,0,0.15); align-self: flex-start; }
    aside h3 { color: #2e7d32; margin-bottom: 10px; }
    aside ul { list-style: none; }
    aside li { padding: 8px 0; border-bottom: 1px solid #e0e0e0; }
    main { flex: 3; }
    main h2 { color: #2e7d32; margin-bottom: 15px; }

    /* Product cards */
    .cards { display: flex; flex-wrap: wrap; gap: 20px; margin-bottom: 25px; }
    .card { flex: 1 1 200px; background: #fff; border-radius: 8px; text-align: center;
            box-shadow: 0 2px 6px rgba(0,0,0,0.15); overflow: hidden; transition: transform 0.3s; }
    .card:hover { transform: translateY(-6px); box-shadow: 0 6px 14px rgba(0,0,0,0.25); }
    .card-img { font-size: 64px; padding: 25px 0; background: #e8f5e9; }
    .card-body { padding: 15px; }
    .card-body h3 { margin-bottom: 5px; }
    .price { color: #c62828; font-weight: bold; margin: 8px 0 12px; }

    /* Menu list */
    .menu-box { background: #fff; padding: 20px; border-radius: 8px; margin-bottom: 25px;
                box-shadow: 0 2px 6px rgba(0,0,0,0.15); }
    .menu-box h3 { color: #1b5e20; margin: 10px 0 5px; }

    /* Footer */
    footer { background: #1b5e20; color: #fff; text-align: center; padding: 20px; margin-top: 30px; }

    /* Responsive (Media Queries) */
    @media (max-width: 768px) {
      .container { flex-direction: column; }
      aside { align-self: stretch; }
      nav { flex-direction: column; text-align: center; }
      .hero h2 { font-size: 24px; }
    }
    @media (max-width: 480px) {
      .card { flex: 1 1 100%; }
    }
  </style>
</head>
<body>

<!-- Header -->
<header>
  <h1>FreshCart Online Grocery Store</h1>
  <p>Fresh Products &bull; Fast Delivery</p>
</header>

<!-- Navigation -->
<nav>
  <a href="#home">Home</a>
  <a href="#products">Products</a>
  <a href="#prices">Price List</a>
  <a href="#about">About</a>
  <a href="#contact">Contact</a>
</nav>

<!-- Hero Section -->
<section class="hero" id="home">
  <h2>Fresh Groceries Delivered to Your Door</h2>
  <p>Vegetables, fruits, dairy and daily essentials at the best prices.</p>
  <a href="#products" class="btn">Shop Now</a>
</section>

<!-- Main Content with Sidebar -->
<div class="container">

  <aside>
    <h3>Categories</h3>
    <ul>
      <li>Vegetables</li>
      <li>Fruits</li>
      <li>Dairy &amp; Eggs</li>
      <li>Rice &amp; Pulses</li>
      <li>Snacks</li>
      <li>Beverages</li>
    </ul>
  </aside>

  <main>
    <!-- Popular Products -->
    <h2 id="products">Popular Products</h2>
    <div class="cards">
      <div class="card">
        <div class="card-img">&#127813;</div>
        <div class="card-body">
          <h3>Fresh Tomato</h3>
          <p>Farm fresh and juicy.</p>
          <p class="price">Rs. 40 / kg</p>
          <button>Add to Cart</button>
        </div>
      </div>
      <div class="card">
        <div class="card-img">&#127822;</div>
        <div class="card-body">
          <h3>Red Apple</h3>
          <p>Sweet and crunchy.</p>
          <p class="price">Rs. 180 / kg</p>
          <button>Add to Cart</button>
        </div>
      </div>
      <div class="card">
        <div class="card-img">&#129371;</div>
        <div class="card-body">
          <h3>Fresh Milk</h3>
          <p>Pure and full cream.</p>
          <p class="price">Rs. 56 / litre</p>
          <button>Add to Cart</button>
        </div>
      </div>
    </div>

    <!-- Price List -->
    <div class="menu-box" id="prices">
      <h2>Price List</h2>
      <h3>Vegetables</h3>
      <p>Onion - Rs. 35/kg</p>
      <p>Potato - Rs. 30/kg</p>
      <h3>Staples</h3>
      <p>Basmati Rice - Rs. 450/5 kg</p>
      <p>Toor Dal - Rs. 150/kg</p>
      <h3>Beverages</h3>
      <p>Orange Juice - Rs. 90/litre</p>
      <p>Green Tea - Rs. 120/box</p>
    </div>

    <!-- About -->
    <div class="menu-box" id="about">
      <h2>About Us</h2>
      <p>FreshCart is an online grocery store that delivers fresh and quality products
         from local farmers and trusted suppliers straight to your home.</p>
    </div>

    <!-- Contact -->
    <div class="menu-box" id="contact">
      <h2>Contact Us</h2>
      <p>Location: Coimbatore, Tamil Nadu</p>
      <p>Phone: +91 9876543210</p>
      <p>Email: support@freshcart.com</p>
    </div>
  </main>

</div>

<!-- Footer -->
<footer>
  <h3>FreshCart Online Grocery Store</h3>
  <p>Fresh Products &bull; Fast Delivery</p>
  <p>&copy; 2026 FreshCart</p>
</footer>

</body>
</html>
