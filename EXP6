<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>FreshCart - Grocery Order Planner</title>
  <link rel="stylesheet" href="style.css">
</head>
<body>

<header>
  <div class="brand">
    <h1>&#128722; FreshCart</h1>
    <p class="tagline">Fresh Groceries, Happy Homes</p>
  </div>
  <div class="stats">
    <div class="stat-pill">
      <span>Pending</span>
      <strong id="openCount">0</strong>
    </div>
    <div class="stat-pill">
      <span>Purchased</span>
      <strong id="doneCount">0</strong>
    </div>
  </div>
</header>

<main>
  <!-- Add Item Form -->
  <section class="add-section">
    <h2>Add Grocery Item</h2>
    <form id="addForm">
      <div class="input-row">
        <select id="categorySelect">
          <option value="Vegetables">Vegetables</option>
          <option value="Fruits">Fruits</option>
          <option value="Dairy">Dairy</option>
          <option value="Staples">Staples</option>
          <option value="Beverages">Beverages</option>
        </select>
        <input type="text" id="itemInput" placeholder="Enter grocery item..." required>
        <button type="submit" id="addBtn">+ Add Item</button>
      </div>
    </form>
  </section>

  <!-- Filter Section -->
  <section class="filter-section">
    <div class="filter-tabs">
      <button class="tab active" data-filter="all">All Items</button>
      <button class="tab" data-filter="pending">Pending</button>
      <button class="tab" data-filter="done">Purchased</button>
    </div>
    <button id="clearDoneBtn">Clear Purchased</button>
  </section>

  <!-- Item List -->
  <section class="list-section">
    <ul id="itemList"></ul>
    <div id="emptyState" class="empty-state hidden">
      <p>No items available.<br>Add your grocery items!</p>
    </div>
  </section>
</main>

<footer>
  <p>&copy; 2026 FreshCart Online Grocery Store</p>
  <p>Fresh Food | Quality Service | Fast Delivery</p>
</footer>

<script src="app.js"></script>
</body>
</html>
